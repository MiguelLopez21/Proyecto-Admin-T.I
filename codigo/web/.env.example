# Conexión a PostgreSQL. En Dokploy: Database "ecopetrol-db" -> pestaña General -> Internal Connection URL.
# Prueba local con docker-compose.dev.yml:
#   DATABASE_URL=postgresql://ecopetrol_app:solo-pruebas-local@ecopetrol-db-dev:5432/ecopetrol
DATABASE_URL=postgresql://ecopetrol_app:CAMBIAR@ecopetrol-db:5432/ecopetrol

# Datos que se muestran en el Portal TI (reemplazan {SERVER_IP} y {DOMINIO} de la tabla servicios_ti)
SERVER_IP=172.20.10.14
DOMINIO=ecopetrol-ti.duckdns.org

# Solo docker-compose.dev.yml: clave del PostgreSQL de prueba
DEV_DB_PASSWORD=solo-pruebas-local
