# Subred(es) de los clientes a los que se les sirve hora. Varias: separadas por coma.
# Demo (hotspot): 172.20.10.0/28   ·   Pruebas en casa: agregar la LAN, ej. 172.20.10.0/28,192.168.1.0/24
ALLOW_SUBNET=172.20.10.0/28

# true: chrony ajusta el reloj del host (necesita SYS_TIME). false: solo sirve hora (pruebas).
AJUSTAR_RELOJ=true

TZ=America/Bogota
